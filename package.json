{
  "name": "myass",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @myass/db db:generate",
    "db:migrate": "pnpm --filter @myass/db db:migrate",
    "db:push": "pnpm --filter @myass/db db:push",
    "db:studio": "pnpm --filter @myass/db db:studio"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "2.10.12",
    "@eslint/js": "^9.34.0",
    "typescript-eslint": "^8.41.0"
  }
}
