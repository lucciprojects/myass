NEXT_PUBLIC_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
MYASS_AGENT_HOST=127.0.0.1
MYASS_AGENT_PORT=3002

# Two-machine setup: the agent is a separate native process and does not read
# this file. Export these in its own environment on the Pi.
#   MYASS_CONTROL_HOST=0.0.0.0     # 0.0.0.0, or the Pi's LAN address
#   MYASS_CONTROL_PORT=3002
# and set MYASS_AGENT_HOST above to the Pi's IP.
